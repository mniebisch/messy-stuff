{
    "build": {
        "context": "..",
        "dockerfile": "../Dockerfile",
        "target": "devcontainer"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.isort",
                "ms-python.black-formatter",
                "ms-python.mypy-type-checker",
                "anthropic.claude-code" // Added
            ],
            "settings": {
                "python.defaultInterpreterPath": "/opt/conda/bin/python"
            }
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/git:1": {}
    },
    "runArgs": [
        "--gpus=all",
        "--shm-size=8g"
    ],
    "forwardPorts": [
        8050
    ],
    "portsAttributes": {
        "8050": {
            "label": "Dash",
            "onAutoForward": "openBrowser"
        }
    },
    "remoteUser": "devuser",
    "mounts": [
        "source=${localEnv:HOME}/data,target=/mnt/data,type=bind",
        "source=${localEnv:HOME}/.claude,target=/home/devuser/.claude,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.claude.json,target=/home/devuser/.claude.json,type=bind,consistency=cached" // Added: auth token lives here
    ],
    // "containerEnv": {
    //     "HF_HUB_CACHE": "/mnt/huggingface/hub"
    // },
    // "remoteEnv": {
    //     "HF_HUB_CACHE": "/mnt/huggingface/hub"
    // }
}